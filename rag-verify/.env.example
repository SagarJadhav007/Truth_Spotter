GEMINI_API_KEY=your_gemini_api_key
SERPAPI_KEY=your_serpapi_key

# Qdrant Cloud Configuration
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=news_articles

# Optional: OpenAI API Key (if you want to use OpenAI models as fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Application Configuration
NODE_ENV=development
PORT=3000

# Redis (response cache + distributed rate limiting)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
CACHE_TTL_SECONDS=7200
CACHE_TTL_AGENTIC_SECONDS=3600

# Monitoring Configuration
UPDATE_INTERVAL_MINUTES=60
MAX_ARTICLES_PER_TOPIC=20
CONFIDENCE_THRESHOLD=70
